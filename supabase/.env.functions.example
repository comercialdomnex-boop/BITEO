# BITEO — Edge Functions local (Sandbox). Copie para supabase/.env.local e preencha localmente.
# NUNCA commitar o arquivo com valores reais.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
TURNSTILE_SECRET_KEY=
CHECKOUT_ALLOWED_ORIGINS=http://localhost:5173
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY normalmente são injetados pelo Supabase CLI local.
# Não coloque credenciais service_role em variáveis VITE_* ou no frontend.
